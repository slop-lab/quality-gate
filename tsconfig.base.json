{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@slop-lab/qg-core": ["packages/core/src/index.ts"],
      "@slop-lab/qg-test-utils": ["packages/test-utils/src/index.ts"],
      "@slop-lab/qg-rules-git": ["packages/rules-git/src/index.ts"],
      "@slop-lab/qg-rules-files": ["packages/rules-files/src/index.ts"],
      "@slop-lab/qg-rules-package-manager": [
        "packages/rules-package-manager/src/index.ts"
      ],
      "@slop-lab/qg-rules-test": ["packages/rules-test/src/index.ts"],
      "@slop-lab/qg-rules-recommended": [
        "packages/rules-recommended/src/index.ts"
      ]
    }
  }
}
