{
  "name": "@slop-lab/qg-test-utils",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@slop-lab/qg-core": "0.1.0"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map"
  ],
  "scripts": {
    "build": "tsc -b && tsdown --config ../../tsdown.config.ts --filter @slop-lab/qg-test-utils",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/quality-gate.git",
    "directory": "packages/test-utils"
  },
  "description": "Fixtures, rule execution, and diagnostic assertions for testing custom QG rules",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
