{
  "name": "@slop-lab/qg-rules-recommended",
  "version": "0.1.1",
  "description": "Default recommended rule set for QG",
  "type": "module",
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map"
  ],
  "scripts": {
    "build": "tsc -b && tsdown --config ../../tsdown.config.ts --filter @slop-lab/qg-rules-recommended",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/quality-gate.git",
    "directory": "packages/rules-recommended"
  },
  "dependencies": {
    "@slop-lab/qg-core": "0.1.0",
    "@slop-lab/qg-rules-git": "0.1.0",
    "@slop-lab/qg-rules-files": "0.1.1"
  },
  "devDependencies": {
    "@slop-lab/qg-rule-testing": "0.1.0",
    "@slop-lab/qg-rules-biome": "0.1.0",
    "@slop-lab/qg-rules-prettier": "0.1.0",
    "@slop-lab/qg-rules-eslint": "0.1.0",
    "@slop-lab/qg-rules-js": "0.1.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT"
}
