{
  "name": "@slop-lab/qg",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist/index.cjs",
    "dist/index.d.cts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "qg": "dist/index.cjs"
  },
  "scripts": {
    "build": "tsc -b && tsdown --config ../../tsdown.config.ts --filter @slop-lab/qg",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@slop-lab/qg-core": "workspace:*",
    "@slop-lab/qg-rules-files": "workspace:*",
    "@slop-lab/qg-rules-git": "workspace:*",
    "@slop-lab/qg-rules-package-manager": "workspace:*",
    "@slop-lab/qg-rules-test": "workspace:*",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/quality-gate.git",
    "directory": "packages/cli"
  },
  "inlinedDependencies": {
    "yaml": "2.9.1"
  },
  "description": "Git-aware repository quality checks with the qg CLI",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.cjs",
    "./package.json": "./package.json"
  }
}
