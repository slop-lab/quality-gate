{
  "name": "@slop-lab/qg",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "qg": "dist/index.mjs"
  },
  "scripts": {
    "build": "tsc -b && tsdown --config ../../tsdown.config.ts --filter @slop-lab/qg",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/quality-gate.git",
    "directory": "packages/cli"
  },
  "description": "Git-aware repository quality checks with the qg CLI",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@slop-lab/qg-core": "0.1.0",
    "@slop-lab/qg-rules-recommended": "0.1.0",
    "yaml": "^2.9.1"
  },
  "module": "./dist/index.mjs",
  "license": "MIT"
}
