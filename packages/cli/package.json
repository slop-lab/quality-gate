{
  "name": "quality-gate",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist/index.cjs",
    "dist/index.d.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "quality-gate": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "build": "tsc -b && pnpm run bundle",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@quality-gate/core": "workspace:*",
    "@quality-gate/rules-files": "workspace:*",
    "@quality-gate/rules-git": "workspace:*",
    "@quality-gate/rules-package-manager": "workspace:*",
    "@quality-gate/rules-test": "workspace:*",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  }
}
